{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.3.2/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Real vs Virtual Study Part1",
    "version": "1",
    "authors": ["Leana"],
    "date": "2025-12-02",
    "description": "First Part",
    "organizations": ["inria"]
  },
  "uiConfig": {
    "contactEmail": "leana.petiot@inria.fr",
    "helpTextPath": "_real_virtual_study/assets/content/help.md",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "withProgressBar": true,
    "autoDownloadStudy": false,
    "withSidebar": false,
    "enumerateQuestions": true,
    "minWidthSize": 0,
    "minHeightSize": 0,
    "studyEndMsg": "Thank you for completing the study. You may click this link and return to Prolific: [https://app.prolific.com/submissions/complete?cc=CE96X7ST&PROLIFIC_ID={PARTICIPANT_ID}](https://app.prolific.com/submissions/complete?cc=CE96X7ST&PROLIFIC_ID={PARTICIPANT_ID})",
    "urlParticipantIdParam": "PROLIFIC_ID"
  },
  "baseComponents": {
    "video-task-template": {
      "type": "website",
      "path": "_real_virtual_study/trial.html",
      "instruction": "Watch the video and answer the questions.",
      "forceCompletion": true,
      "nextButtonLocation": "belowStimulus",
      "response": [
        {
          "id": "completionSignal",
          "type": "reactive",
          "location": "sidebar",
          "prompt": "Click on next to continue with another object",
          "required": true,
          "hidden": true
        },
        {
          "id": "objectName",
          "type": "reactive",
          "required": false,
          "hidden": true,
          "prompt": "Object Name"
        },
        {
          "id": "sourceChoice",
          "type": "reactive",
          "required": false,
          "hidden": true,
          "prompt": "Real or Virtual"
        },
        {
          "id": "confidence",
          "type": "reactive",
          "required": false,
          "hidden": true,
          "prompt": "Confidence Level"
        }
      ]
    }
  },

  "components": {
    "myAttentionCheckComponent" : {
      "type": "questionnaire",
      "response": [
        {
          "id": "AttentionCheck1",
          "prompt": "The colour test you are about to take part in is very simple, when asked for your favorite colour you must select 'Green'. This is an attention check.\n\nBased on the text you read above what colour have you been asked to enter ?",
          "required": true,
          "type": "radio",
          "options": [
            "Blue",
            "Yellow",
            "Orange",
            "Red",
            "Green"
          ]
        }
      ],
      "correctAnswer": [
        {
          "id": "AttentionCheck1",
          "answer": "Green"
        }
      ]
    },
    "IntroPage": {
      "type": "markdown",
      "path": "_real_virtual_study/assets/content/part1_instructions.md",
      "nextButtonText": "Start",
      "response": []
    },
    "ConsentPage": {
      "type": "markdown",
      "path": "_real_virtual_study/assets/content/part1_consent.md",
      "nextButtonText": "I agree",
      "response": []
    },

